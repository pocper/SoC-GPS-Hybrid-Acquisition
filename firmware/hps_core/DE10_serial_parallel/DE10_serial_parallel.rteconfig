<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<configuration xmlns:xs="http://www.w3.org/2001/XMLSchema-instance">
  <packages/>
  <device Dclock="12000000" Dcore="Cortex-A9" DcoreVersion="r4p1" Dendian="Little-endian" Dfamily="ARM Cortex A9" Dfpu="DP_FPU" Dmpu="MPU" Dname="ARMCA9" Dvendor="ARM:82" info="ARM , 1056 MB RAM, 128 MB ROM" url="https://www.keil.com/dd2/arm/armca9">
    <package info="ARM Cortex Reference Subsystems Device Family Pack" name="Cortex_DFP" url="https://www.keil.com/pack/" vendor="ARM" version="1.1.0"/>
  </device>
  <toolchain Tcompiler="ARMCC" Toutput="exe"/>
  <components>
    <component Cclass="CMSIS" Cgroup="CORE" Cvendor="ARM" Cversion="6.1.0">
      <package name="CMSIS" url="https://www.keil.com/pack/" vendor="ARM" version="6.1.0"/>
      <file category="doc" name="CMSIS/Documentation/html/Core_A/index.html"/>
      <file category="include" name="CMSIS/Core/Include/"/>
    </component>
    <component Capiversion="1.0.1" Cclass="CMSIS" Cgroup="OS Tick" Csub="Private Timer" Cvendor="ARM" Cversion="1.0.2">
      <package name="CMSIS" url="https://www.keil.com/pack/" vendor="ARM" version="6.1.0"/>
      <file category="sourceC" name="CMSIS/RTOS2/Source/os_tick_ptim.c"/>
    </component>
    <component Capiversion="2.3.0" Cclass="CMSIS" Cgroup="RTOS2" Csub="Keil RTX5" Cvariant="Source" Cvendor="ARM" Cversion="5.9.0">
      <package name="CMSIS-RTX" url="https://www.keil.com/pack/" vendor="ARM" version="5.9.0"/>
      <file category="doc" name="Documentation/index.html"/>
      <file category="other" name="RTX5.scvd"/>
      <file category="header" name="Include/rtx_os.h"/>
      <file attr="config" category="header" name="Config/RTX_Config.h" version="5.6.0"/>
      <file attr="config" category="source" name="Config/RTX_Config.c" version="5.2.0"/>
      <file attr="config" category="source" condition="ARMv7-A Device" name="Config/handlers.c" version="5.1.0"/>
      <file attr="template" category="source" name="Template/main.c" select="RTX 'main' function" version="2.1.0"/>
      <file attr="template" category="source" name="Template/Events.c" select="RTX Events" version="2.0.0"/>
      <file attr="template" category="source" name="Template/MemPool.c" select="RTX Memory Pool" version="2.0.0"/>
      <file attr="template" category="source" name="Template/MsgQueue.c" select="RTX Message Queue" version="2.0.0"/>
      <file attr="template" category="source" name="Template/Mutex.c" select="RTX Mutex" version="2.0.0"/>
      <file attr="template" category="source" name="Template/Semaphore.c" select="RTX Semaphore" version="2.0.0"/>
      <file attr="template" category="source" name="Template/Thread.c" select="RTX Thread" version="2.0.0"/>
      <file attr="template" category="source" name="Template/Timer.c" select="RTX Timer" version="2.0.1"/>
      <file attr="template" category="source" name="Template/svc_user.c" select="RTX SVC User Table" version="1.0.0"/>
      <file category="source" name="Source/rtx_kernel.c"/>
      <file category="source" name="Source/rtx_thread.c"/>
      <file category="source" name="Source/rtx_delay.c"/>
      <file category="source" name="Source/rtx_timer.c"/>
      <file category="source" name="Source/rtx_evflags.c"/>
      <file category="source" name="Source/rtx_mutex.c"/>
      <file category="source" name="Source/rtx_semaphore.c"/>
      <file category="source" name="Source/rtx_memory.c"/>
      <file category="source" name="Source/rtx_mempool.c"/>
      <file category="source" name="Source/rtx_msgqueue.c"/>
      <file category="source" name="Source/rtx_system.c"/>
      <file category="source" name="Source/rtx_evr.c"/>
      <file category="source" name="Source/rtx_lib.c"/>
      <file category="source" condition="GNUASM ARMv7-A" name="Source/GCC/irq_armv7a.S"/>
    </component>
    <component Cclass="CMSIS-Compiler" Cgroup="CORE" Cvendor="ARM" Cversion="1.1.0">
      <package name="CMSIS-Compiler" url="https://www.keil.com/pack/" vendor="ARM" version="2.1.0"/>
      <file category="sourceC" name="source/armcc/retarget_io.c"/>
    </component>
    <component Capiversion="1.1.0" Cclass="CMSIS-Compiler" Cgroup="STDIN" Csub="Custom" Cvendor="ARM" Cversion="1.1.0" custom="1">
      <package name="CMSIS-Compiler" url="https://www.keil.com/pack/" vendor="ARM" version="2.1.0"/>
      <file attr="template" category="sourceC" name="template/stdio/stdin_user.c" select="STDIN User Template"/>
    </component>
    <component Capiversion="1.1.0" Cclass="CMSIS-Compiler" Cgroup="STDOUT" Csub="Custom" Cvendor="ARM" Cversion="1.1.0" custom="1">
      <package name="CMSIS-Compiler" url="https://www.keil.com/pack/" vendor="ARM" version="2.1.0"/>
      <file attr="template" category="sourceC" name="template/stdio/stdout_user.c" select="STDOUT User Template"/>
    </component>
    <component Capiversion="1.0.0" Cclass="Device" Cgroup="IRQ Controller" Csub="GIC" Cvendor="ARM" Cversion="1.2.0" deviceDependent="1">
      <package name="CMSIS" url="https://www.keil.com/pack/" vendor="ARM" version="6.1.0"/>
      <file category="sourceC" deviceDependent="1" name="CMSIS/Core/Source/irq_ctrl_gic.c"/>
    </component>
    <component Cclass="Device" Cgroup="Startup" Cvariant="C Startup" Cvendor="ARM" Cversion="1.2.0" deviceDependent="1">
      <package name="Cortex_DFP" url="https://www.keil.com/pack/" vendor="ARM" version="1.1.0"/>
      <file category="header" deviceDependent="1" name="Device/ARMCA9/Include/ARMCA9.h"/>
      <file attr="config" category="sourceC" deviceDependent="1" name="Device/ARMCA9/Source/startup_ARMCA9.c" version="1.0.1"/>
      <file attr="config" category="linkerScript" condition="ARMCC6" deviceDependent="1" name="Device/ARMCA9/Config/ARMCA9_ac6.sct" version="1.0.0"/>
      <file attr="config" category="sourceC" deviceDependent="1" name="Device/ARMCA9/Source/system_ARMCA9.c" version="1.0.1"/>
      <file attr="config" category="sourceC" deviceDependent="1" name="Device/ARMCA9/Source/mmu_ARMCA9.c" version="1.2.0"/>
      <file attr="config" category="header" deviceDependent="1" name="Device/ARMCA9/Config/mem_ARMCA9.h" version="1.1.0"/>
    </component>
  </components>
  <apis>
    <api Capiversion="1.1.0" Cclass="CMSIS-Compiler" Cgroup="STDOUT" Cvendor="ARM" Cversion="1.1.0" exclusive="1">
      <package name="CMSIS-Compiler" url="https://www.keil.com/pack/" vendor="ARM" version="2.1.0"/>
      <file category="header" name="include/retarget_stdout.h"/>
    </api>
    <api Capiversion="1.1.0" Cclass="CMSIS-Compiler" Cgroup="STDIN" Cvendor="ARM" Cversion="1.1.0" exclusive="1">
      <package name="CMSIS-Compiler" url="https://www.keil.com/pack/" vendor="ARM" version="2.1.0"/>
      <file category="header" name="include/retarget_stdin.h"/>
    </api>
    <api Capiversion="1.0.1" Cclass="CMSIS" Cgroup="OS Tick" Cvendor="ARM" Cversion="1.0.1" exclusive="1">
      <package name="CMSIS" url="https://www.keil.com/pack/" vendor="ARM" version="6.1.0"/>
      <file category="header" name="CMSIS/RTOS2/Include/os_tick.h"/>
    </api>
    <api Capiversion="1.0.0" Cclass="Device" Cgroup="IRQ Controller" Cvendor="ARM" Cversion="1.0.0" exclusive="1">
      <package name="CMSIS" url="https://www.keil.com/pack/" vendor="ARM" version="6.1.0"/>
      <file category="header" name="CMSIS/Core/Include/a-profile/irq_ctrl.h"/>
    </api>
    <api Capiversion="2.3.0" Cclass="CMSIS" Cgroup="RTOS2" Cvendor="ARM" Cversion="2.3.0" exclusive="1">
      <package name="CMSIS" url="https://www.keil.com/pack/" vendor="ARM" version="6.1.0"/>
      <file category="doc" name="CMSIS/Documentation/html/RTOS2/index.html"/>
      <file category="header" name="CMSIS/RTOS2/Include/cmsis_os2.h"/>
    </api>
  </apis>
</configuration>
